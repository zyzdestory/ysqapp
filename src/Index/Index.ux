      }
    }

    .recipe-tags {
      display: flex;
      flex-wrap: wrap;

      .tag {
        font-size: 22px;
        color: #ff6b6b;
        background-color: #ffeaea;
        padding: 6px 15px;
        border-radius: 20px;
        margin-right: 10px;
        margin-bottom: 5px;
      }
    }
  }
}

</style>