<template>
  <div class="recipe-wrapper">
    <div class="header">
      <text class="title">美食食谱</text>
      <text class="subtitle">发现美味，轻松下厨</text>
    </div>

    <div class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        value="{{searchKeyword}}"
        placeholder="搜索菜谱"
        @change="onSearch"
      />
    </div>

    <div class="category-tabs">
      <div
        class="category-tab {{activeCategory === $item.key?'active':''}}"
        for="{{categories}}"
        @click="btnchangenav($item)"
      >
        <text
          class="tab-text {{activeCategory === $item.key?'activetext':''}}"
          >{{ $item.name }}</text
        >
      </div>
    </div>

    <list class="recipe-list">
      <list-item
        type="listitem"
        for="{{filteredRecipes}}"
        @click="openDetail($item)"
      >
        <div class="recipe-card">
          <image class="recipe-image" src="{{$item.image}}" mode="aspectFill" />
          <div class="recipe-info">
            <text class="recipe-name">{{ $item.name }}</text>
            <text class="recipe-desc">{{ $item.description }}</text>
            <div class="recipe-meta">
              <text class="meta-item">⏱️ {{ $item.time }}</text>
              <text class="meta-item">👥 {{ $item.servings }}</text>
            </div>
            <div class="recipe-tags">
              <text class="tag" for="{{items in $item.tags}}" :key="tag">{{
                items
              }}</text>
            </div>
          </div>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import prompt from '@system.prompt'
    import router from '@system.router'
import recipes from "../helper/recipes.js"
export default {
  data: {
    title: '美食食谱',
    activeCategory: 'all',
    searchKeyword: '',
    showDetail: false,
    currentRecipe: {},
    categories: [
      { key: 'all', name: '全部' },
      { key: 'meat', name: '肉类' },
      { key: 'vegetable', name: '素菜' },
      { key: 'seafood', name: '海鲜' },
      { key: 'soup', name: '汤羹' },
      { key: 'dessert', name: '甜品' }
    ],
    recipes:[]
  },
  computed: {
    filteredRecipes() {
      let result = this.recipes
      if (this.activeCategory !== 'all') {
        result = result.filter(r => r.category === this.activeCategory)
      }
      if (this.searchKeyword) {
        const keyword = this.searchKeyword.toLowerCase()
        result = result.filter(r => r.name.toLowerCase().includes(keyword) || r.description.toLowerCase().includes(keyword))
      }
      return result
    }
  },
  onInit() {
    this.recipes=recipes
  },
  btnchangenav(item) {
    this.activeCategory = item.key
  },
  onSearch(e) {
    this.searchKeyword = e.text
  },
  openDetail(recipe) {
    this.showDetail = true
    router.push({
      uri:'/detail',
      params:{
        recipe
      }
    })
  },
  handleclose() {
    this.showDetail = false
  }
}
</script>

