<script>
import manifest from '../../manifest.json'

export default {
  data() {
    return {
      productname:""
    }
  },
  onInit() {
    this.productname=manifest.name
  },
  methods: {
    openLink(url) {
      // 快应用中打开链接需使用 router.push 或 system 接口
      // 此处为演示，实际可使用快应用提供的 web 组件或跳转
      console.log('打开链接：', url);
      // 示例：使用快应用 system 打开浏览器
      const system = require('@system.app');
      system.openURL({
        url: url,
        fail: function (data, code) {
          console.log('打开链接失败');
        }
      });
    }
  }
}
</script>

