.contact-wrapper {
  padding-bottom: 30px;
    flex-direction: column;

}

.header {
  display: flex;
  align-items: center;
  padding: 20px;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff;
  top: 0;
  z-index: 100;
  flex-direction: column;

  .back-btn {
    font-size: 42px;
    margin-right: 20px;
    padding: 10px;
    width: 100%;
  }

  .title {
    font-size: 42px;
    font-weight: bold;
  }
}

.feedback-section {
  margin: 15px;
  border-radius: 12px;
  padding: 20px;
  flex-direction: column;

  .section-title {
    font-size: 32px;
    font-weight: bold;
    color: #333;
    margin-bottom: 15px;
  }
  .textarea{
    border: 1px solid #000000;
    width: 100%;
    height: 200px;
    margin-bottom: 20px;
    padding: 10px
  }

  .feedback-input {
    width: 100%;
    height: 150px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 15px;
    font-size: 15px;
    color: #333;
    margin-bottom: 20px;
    box-sizing: border-box;
  }

  .submit-btn {
    width: 100%;
    background: linear-gradient(135deg, #4ecdc4, #44a08d);
    color: #fff;
    border-radius: 24px;
    font-size: 18px;
