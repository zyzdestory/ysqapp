<template>
  <div class="contact-wrapper">
    <div class="header">
      <text class="title">联系我们</text>
    </div>

    <div class="feedback-section">
      <text class="section-title">您的问题</text>
                <textarea class="textarea" placeholder="请输入您遇到的问题或建议..."  @change="onFeedbackChange">{{feedbackContent}}</textarea>

      <div class="submit-btn" @click="submitFeedback"><text>提交</text></div>
    </div>
  </div>
</template>

<script>
import prompt from '@system.prompt'
    import router from '@system.router'

export default {
  data: {
    feedbackContent: ''
  },

  onInit() {},

  goBack() {
    router.back()
  },

  onFeedbackChange(e) {
    this.feedbackContent = e.text
  },

  submitFeedback() {
    if (!this.feedbackContent.trim()) {
      prompt.showToast({
        message: '请输入您的问题',
        duration: 2000
      })
      return
    }

    prompt.showToast({
      message: '感谢您的反馈，我们会尽快处理！',
      duration: 2000
    })

    this.feedbackContent = ''
    router.back()
  }
}
</script>

